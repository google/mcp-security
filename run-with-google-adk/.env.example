# Vertex AI and Gemini model configuration
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_MODEL=gemini-3.1-pro-preview

# Google SecOps (Chronicle SIEM) MCP credentials
# Optional SecOps auth env vars forwarded when set: SECOPS_SA_PATH, SECOPS_IMPERSONATE_SERVICE_ACCOUNT
CHRONICLE_PROJECT_ID=
CHRONICLE_CUSTOMER_ID=
CHRONICLE_REGION=us

# Google Threat Intelligence (GTI) MCP credentials
VT_APIKEY=

# Google SecOps SOAR MCP credentials
# Optional SOAR TLS env var forwarded when set: SOAR_VERIFY_SSL
SOAR_URL=
SOAR_APP_KEY=

# MCP server enablement flags (leave blank to auto-detect from credentials or URL; set True/False to override)
LOAD_SCC_MCP=False
LOAD_SECOPS_MCP=
LOAD_GTI_MCP=
LOAD_SECOPS_SOAR_MCP=

# Optional remote Streamable HTTP MCP URL overrides (https:// or loopback http://localhost, 127.0.0.1, [::1])
SECOPS_MCP_URL=
SCC_MCP_URL=
GTI_MCP_URL=
SECOPS_SOAR_MCP_URL=

# MCP stdio initialization timeout in seconds
STDIO_PARAM_TIMEOUT=60.0
